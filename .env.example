# Copy to .env and adjust. Never commit .env.

# ---- shared ----
# LAN IP of the machine running docker compose (used by the mobile app on a physical device)
HOST_IP=192.168.0.104

# ---- database ----
POSTGRES_USER=agriminds
POSTGRES_DB=agriminds
# Required. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_PORT=5432

# ---- backend (agriminds_api) ----
AGRIMINDS_ENV=development
AGRIMINDS_LOG_LEVEL=INFO
AGRIMINDS_DATA_DIR=./data
AGRIMINDS_REDIS_URL=redis://redis:6379/0
# Host-side URL (inside Compose the backend overrides this with the `postgres` hostname)
AGRIMINDS_DATABASE_URL=postgresql+asyncpg://agriminds:change-me-in-your-env@localhost:5432/agriminds
# Required. Generate one: openssl rand -hex 32
AGRIMINDS_JWT_SECRET=dev-only-insecure-secret-change-me
AGRIMINDS_ACCESS_TOKEN_TTL_MINUTES=15
AGRIMINDS_REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated browser origins allowed to call the API directly (the web app uses a server-side proxy instead)
AGRIMINDS_CORS_ORIGINS=http://localhost:3000
# Comma-separated API keys. Leave empty to disable auth in local development.
AGRIMINDS_API_KEYS=

# ---- Metabase (optional analytics layer) ----
# Self-hosted and open source, so neither the ministry nor any viewer needs a BI licence. The
# server signs a short-lived URL for one dashboard; the secret never reaches the browser. Leave
# these blank and the web app hides the Analytics tab instead of showing a broken frame.
#
# Setup, once:
#   1. Generate a signing key:  openssl rand -hex 32   -> AGRIMINDS_METABASE_SECRET_KEY
#      Put the SAME value here; Compose passes it to both the API and Metabase.
#   2. Start it:  docker compose --profile analytics up -d metabase
#      Open http://localhost:3001 and create the admin account.
#   3. Add the database: Admin > Databases > PostgreSQL. Host `postgres`, port 5432,
#      database `agriminds`, user `agriminds_bi` (create it with `make bi-role`). That role can
#      read the analytics views and nothing else.
#   4. Build a dashboard, then Sharing > Embed > Static embedding > Publish.
#      The dashboard id is the number in its URL -> AGRIMINDS_METABASE_DASHBOARD_ID
#   5. Optional: to scope a development agent to their own woreda, add a dashboard filter on the
#      woreda code, mark it **Locked** in the embed dialog, and put its parameter name below.
#      Locked parameters are signed into the URL, so they cannot be edited client-side.
AGRIMINDS_METABASE_SECRET_KEY=
AGRIMINDS_METABASE_DASHBOARD_ID=
AGRIMINDS_METABASE_WOREDA_PARAM=
# How the API reaches Metabase, and how a browser does. These differ under Compose.
AGRIMINDS_METABASE_SITE_URL=http://metabase:3000
AGRIMINDS_METABASE_PUBLIC_URL=http://localhost:3001
METABASE_PORT=3001
METABASE_DB=metabase
# Address the database answers on from an analyst's own machine. Inside Compose the API knows it
# as `postgres:5432`, which resolves only on that network, so a desktop tool needs this set.
AGRIMINDS_ANALYTICS_PUBLIC_HOST=

# ---- frontend (Next.js) ----
# Server-side only: where the Next.js proxy forwards /api/* requests
API_INTERNAL_URL=http://backend:8000
API_KEY=

# ---- mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1
EXPO_PUBLIC_API_KEY=
