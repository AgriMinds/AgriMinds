# Copy to .env and adjust. Never commit .env.

# ---- shared ----
# LAN IP of the machine running docker compose (used by the mobile app on a physical device)
HOST_IP=192.168.0.104

# ---- database ----
POSTGRES_USER=agriminds
POSTGRES_DB=agriminds
# Required. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_PORT=5432

# ---- backend (agriminds_api) ----
AGRIMINDS_ENV=development
AGRIMINDS_LOG_LEVEL=INFO
AGRIMINDS_DATA_DIR=./data
AGRIMINDS_REDIS_URL=redis://redis:6379/0
# Host-side URL (inside Compose the backend overrides this with the `postgres` hostname)
AGRIMINDS_DATABASE_URL=postgresql+asyncpg://agriminds:change-me-in-your-env@localhost:5432/agriminds
# Required. Generate one: openssl rand -hex 32
AGRIMINDS_JWT_SECRET=dev-only-insecure-secret-change-me
AGRIMINDS_ACCESS_TOKEN_TTL_MINUTES=15
AGRIMINDS_REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated browser origins allowed to call the API directly (the web app uses a server-side proxy instead)
AGRIMINDS_CORS_ORIGINS=http://localhost:3000
# Comma-separated API keys. Leave empty to disable auth in local development.
AGRIMINDS_API_KEYS=

# ---- Power BI (optional analytics layer) ----
# Embedding uses the "app owns data" model: one service principal holds the workspace licence
# and the server mints a short-lived token per viewer, so ministry staff need no Power BI
# licence of their own. Leave these blank and the web app hides the Analytics tab instead of
# showing a broken frame.
#
# Setup, once, in Azure:
#   1. Entra ID > App registrations > New registration (single tenant). Note the Application
#      (client) ID and Directory (tenant) ID; create a client secret.
#   2. Add the app to a security group, and in the Power BI admin portal enable
#      "Allow service principals to use Power BI APIs" for that group.
#   3. In the Power BI workspace: Access > add the security group as Member (or Contributor).
#   4. Publish the report. The workspace id and report id are in its URL:
#      app.powerbi.com/groups/<workspace-id>/reports/<report-id>
#   5. Needs a paid capacity (Fabric F-SKU or Power BI Embedded A-SKU) for app-owns-data embedding.
AGRIMINDS_POWERBI_TENANT_ID=
AGRIMINDS_POWERBI_CLIENT_ID=
AGRIMINDS_POWERBI_CLIENT_SECRET=
AGRIMINDS_POWERBI_WORKSPACE_ID=
AGRIMINDS_POWERBI_REPORT_ID=
# Only needed when the dataset enforces row-level security, so a development agent sees one
# woreda. The RLS expression should compare against CUSTOMDATA(), which carries the woreda code.
AGRIMINDS_POWERBI_DATASET_ID=
AGRIMINDS_POWERBI_RLS_ROLE=
# Address the database answers on from an analyst's own machine. Inside Compose the API knows it
# as `postgres:5432`, which resolves only on that network, so Power BI Desktop needs this set.
AGRIMINDS_ANALYTICS_PUBLIC_HOST=

# ---- frontend (Next.js) ----
# Server-side only: where the Next.js proxy forwards /api/* requests
API_INTERNAL_URL=http://backend:8000
API_KEY=

# ---- mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1
EXPO_PUBLIC_API_KEY=
