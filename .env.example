# Copy to .env and adjust. Never commit .env.

# ---- shared ----
# LAN IP of the machine running docker compose (used by the mobile app on a physical device)
HOST_IP=192.168.0.104

# ---- database ----
POSTGRES_USER=agriminds
POSTGRES_DB=agriminds
# Required. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_PORT=5432

# ---- backend (agriminds_api) ----
AGRIMINDS_ENV=development
AGRIMINDS_LOG_LEVEL=INFO
AGRIMINDS_DATA_DIR=./data
AGRIMINDS_REDIS_URL=redis://redis:6379/0
# Host-side URL (inside Compose the backend overrides this with the `postgres` hostname)
AGRIMINDS_DATABASE_URL=postgresql+asyncpg://agriminds:change-me-in-your-env@localhost:5432/agriminds
# Required. Generate one: openssl rand -hex 32
AGRIMINDS_JWT_SECRET=dev-only-insecure-secret-change-me
AGRIMINDS_ACCESS_TOKEN_TTL_MINUTES=15
AGRIMINDS_REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated browser origins allowed to call the API directly (the web app uses a server-side proxy instead)
AGRIMINDS_CORS_ORIGINS=http://localhost:3000
# Comma-separated API keys. Leave empty to disable auth in local development.
AGRIMINDS_API_KEYS=

# ---- frontend (Next.js) ----
# Server-side only: where the Next.js proxy forwards /api/* requests
API_INTERNAL_URL=http://backend:8000
API_KEY=

# ---- mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1
EXPO_PUBLIC_API_KEY=
