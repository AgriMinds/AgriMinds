{
  "name": "agriminds",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "api-types": "pnpm --filter @agriminds/api-types generate",
    "web": "pnpm --filter @agriminds/web",
    "mobile": "pnpm --filter @agriminds/mobile",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  }
}
