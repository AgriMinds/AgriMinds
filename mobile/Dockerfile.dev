# Expo dev server (Metro) for `docker compose --profile mobile up`.
# Build context must be the REPO ROOT (pnpm workspace). Not a production image.
FROM node:22-alpine
RUN apk add --no-cache libc6-compat git \
    && corepack enable && corepack prepare pnpm@12.6.0 --activate
WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/api-types/package.json packages/api-types/
COPY mobile/package.json mobile/
RUN pnpm install --frozen-lockfile --filter "@agriminds/mobile..."

COPY packages/api-types packages/api-types
COPY mobile mobile

ENV CI=1 \
    EXPO_NO_TELEMETRY=1 \
    # Set to the LAN IP of the docker host so Expo Go on a phone can reach Metro.
    REACT_NATIVE_PACKAGER_HOSTNAME=localhost
EXPOSE 8081
WORKDIR /workspace/mobile
CMD ["pnpm", "exec", "expo", "start", "--lan", "--port", "8081"]
