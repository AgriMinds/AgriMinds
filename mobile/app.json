{
  "expo": {
    "name": "AgriMinds AI-DREWS",
    "slug": "agriminds-drews",
    "scheme": "agriminds",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.gov.agriminds.drews"
    },
    "android": {
      "package": "et.gov.agriminds.drews",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173f36"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#173f36"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriMinds uses your GPS position only to find the watershed grid cell of your farm so the drought advisory matches your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
