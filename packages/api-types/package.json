{
  "name": "@agriminds/api-types",
  "version": "1.1.0",
  "private": true,
  "description": "TypeScript types generated from the agriminds-api OpenAPI schema. Single source of truth for web and mobile.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "openapi.json"],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts --alphabetize --export-type",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  }
}
